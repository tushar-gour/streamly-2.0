generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @db.Char(24)
  username                String                   @unique @db.VarChar(30)
  email                   String                   @unique
  fullName                String                   @db.VarChar(100)
  avatar                  String
  coverImage              String                   @default("")
  password                String
  emailVerifiedAt         DateTime?
  passwordChangedAt       DateTime?
  credentialVersion       Int                      @default(0)
  lastLoginAt             DateTime?
  phoneNumber             String?                  @unique @db.VarChar(32)
  phoneVerifiedAt         DateTime?
  onboardingStatus        String                   @default("active") @db.VarChar(40)
  mfaEnabledAt            DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  videos                  Video[]
  uploadAttempts          VideoUploadAttempt[]
  comments                Comment[]
  likes                   Like[]
  playlists               Playlist[]
  sessions                Session[]
  userRoles               UserRole[]
  emailVerificationTokens EmailVerificationToken[]
  subscribers             Subscription[]           @relation("ChannelSubscriptions")
  subscribedTo            Subscription[]           @relation("SubscriberSubscriptions")
  watchHistory            WatchHistory[]
  watchLater              WatchLater[]
  authChallenges          AuthChallenge[]
  mfaMethods              UserMfa[]
  mfaChallenges           MfaChallenge[]
  mfaTrustTokens          MfaTrustToken[]
  notifications           Notification[]

  @@index([email, username])
  @@index([createdAt])
  @@map("users")
}

model Notification {
  id String @id @db.Char(24)
  userId String @db.Char(24)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String @db.VarChar(40)
  message String @db.VarChar(500)
  readAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model AuthChallenge {
  id             String    @id @db.Char(24)
  userId         String?   @db.Char(24)
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifierHash String    @db.Char(64)
  channel        String    @db.VarChar(20)
  purpose        String    @db.VarChar(60)
  codeHash       String    @db.Char(64)
  expiresAt      DateTime
  consumedAt     DateTime?
  failedAttempts Int       @default(0)
  maxAttempts    Int       @default(5)
  metadataJson   Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([identifierHash, purpose, channel])
  @@index([expiresAt])
  @@index([consumedAt])
  @@map("auth_challenges")
}

model UserMfa {
  id              String    @id @db.Char(24)
  userId          String    @db.Char(24)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String    @default("totp") @db.VarChar(20)
  secretEncrypted String
  enabledAt       DateTime?
  lastVerifiedAt  DateTime?
  recoveryCodesHash Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, type])
  @@index([enabledAt])
  @@map("user_mfa")
}

model MfaChallenge {
  id                    String    @id @db.Char(24)
  userId                String    @db.Char(24)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginMethod           String    @db.VarChar(40)
  credentialVersion     Int?
  expiresAt             DateTime
  consumedAt            DateTime?
  failedAttempts        Int       @default(0)
  deviceFingerprintHash String    @db.Char(64)
  ipHash                String?   @db.Char(64)
  userAgentHash         String?   @db.Char(64)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId, expiresAt])
  @@index([consumedAt])
  @@map("mfa_challenges")
}

model MfaTrustToken {
  id            String    @id @db.Char(24)
  userId        String    @db.Char(24)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique @db.Char(64)
  deviceIdHash  String    @db.Char(64)
  ipHash        String?   @db.Char(64)
  userAgentHash String?   @db.Char(64)
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  lastUsedAt     DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([deviceIdHash])
  @@index([revokedAt])
  @@map("mfa_trust_tokens")
}

model Role {
  id              String           @id @db.Char(24)
  name            String           @unique @db.VarChar(60)
  description     String           @default("") @db.VarChar(255)
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([createdAt])
  @@map("roles")
}

model Permission {
  id              String           @id @db.Char(24)
  name            String           @unique @db.VarChar(120)
  description     String           @default("") @db.VarChar(255)
  resource        String           @db.VarChar(60)
  action          String           @db.VarChar(80)
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([resource, action])
  @@map("permissions")
}

model UserRole {
  id        String   @id @db.Char(24)
  userId    String   @db.Char(24)
  roleId    String   @db.Char(24)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @db.Char(24)
  roleId       String     @db.Char(24)
  permissionId String     @db.Char(24)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id               String    @id @db.Char(24)
  userId           String    @db.Char(24)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @db.Char(64)
  userAgent        String?
  ipAddress        String?   @db.VarChar(64)
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?   @db.VarChar(120)
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @db.Char(24)
  userId    String    @db.Char(24)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, expiresAt])
  @@index([usedAt])
  @@map("email_verification_tokens")
}

model Video {
  id           String          @id @db.Char(24)
  videoFile    String
  thumbnail    String
  title        String          @db.VarChar(200)
  description  String          @db.VarChar(5000)
  duration     Float
  views        Int             @default(0)
  isPublished  Boolean         @default(true)
  moderationHeld Boolean       @default(false)
  uploadAttempt VideoUploadAttempt?
  ownerId      String          @db.Char(24)
  owner        User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  comments     Comment[]
  likes        Like[]
  playlists    PlaylistVideo[]
  watchHistory WatchHistory[]
  watchLater   WatchLater[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([ownerId, createdAt])
  @@index([isPublished, createdAt])
  @@index([views])
  @@map("videos")
}

model VideoUploadAttempt {
  id String @id @db.Char(24)
  ownerId String @db.Char(24)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  requestId String @db.Uuid
  title String @db.VarChar(200)
  status String @db.VarChar(20)
  error String? @db.VarChar(200)
  videoId String? @unique @db.Char(24)
  video Video? @relation(fields: [videoId], references: [id], onDelete: SetNull)
  videoKey String?
  thumbnailKey String?
  expiresAt DateTime
  cleanedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, requestId])
  @@index([ownerId, createdAt])
  @@index([status, expiresAt])
  @@map("video_upload_attempts")
}

model ModerationAction {
  id String @id @db.Char(24)
  actorId String @db.Char(24)
  resourceId String @db.Char(24)
  action String @db.VarChar(40)
  reason String @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([resourceId, createdAt])
  @@index([actorId, createdAt])
  @@map("moderation_actions")
}

model Comment {
  id        String   @id @db.Char(24)
  content   String   @db.VarChar(2000)
  videoId   String   @db.Char(24)
  ownerId   String   @db.Char(24)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  likes     Like[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([videoId, createdAt])
  @@index([ownerId, createdAt])
  @@map("comments")
}

model Like {
  id        String   @id @db.Char(24)
  videoId   String?  @db.Char(24)
  commentId String?  @db.Char(24)
  tweetId   String?  @db.Char(24)
  likedById String   @db.Char(24)
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  likedBy   User     @relation(fields: [likedById], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([videoId, likedById])
  @@unique([commentId, likedById])
  @@unique([tweetId, likedById])
  @@index([videoId])
  @@index([commentId])
  @@index([tweetId])
  @@index([likedById])
  @@map("likes")
}

model Playlist {
  id          String          @id @db.Char(24)
  name        String          @db.VarChar(100)
  description String          @default("") @db.VarChar(500)
  ownerId     String          @db.Char(24)
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isPublic    Boolean         @default(true)
  videos      PlaylistVideo[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([ownerId, createdAt])
  @@index([name, ownerId])
  @@index([isPublic, createdAt])
  @@map("playlists")
}

model PlaylistVideo {
  playlistId String   @db.Char(24)
  videoId    String   @db.Char(24)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([playlistId, videoId])
  @@map("playlist_videos")
}

model Subscription {
  id           String   @id @db.Char(24)
  subscriberId String   @db.Char(24)
  channelId    String   @db.Char(24)
  subscriber   User     @relation("SubscriberSubscriptions", fields: [subscriberId], references: [id], onDelete: Cascade)
  channel      User     @relation("ChannelSubscriptions", fields: [channelId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([subscriberId, channelId])
  @@index([channelId, createdAt])
  @@index([subscriberId, createdAt])
  @@map("subscriptions")
}

model WatchHistory {
  userId    String   @db.Char(24)
  videoId   String   @db.Char(24)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, videoId])
  @@map("watch_history")
}

model WatchLater {
  userId    String   @db.Char(24)
  videoId   String   @db.Char(24)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, videoId])
  @@index([userId, createdAt])
  @@index([videoId])
  @@map("watch_later")
}
